NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_RWA_TOKEN_CONTRACT_ID=
BACKEND_URL=http://localhost:4000
BACKEND_INTERNAL_KEY=
NEXT_PUBLIC_KYC_MOCK_ENABLED=true
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Full connector URL with token, server only.
NEKO_LEGAL_KB_URL=

# Launchpad AI assistant (apps/platform, server only)
# Claude API key. ANTHROPIC_MODEL is optional (default claude-opus-5-5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# RAG knowledge base the assistant searches: MCP connector URL, e.g. the Legal KB
# on Cloud Run, https://<service>.run.app/mcp/<token>. Falls back to NEKO_LEGAL_KB_URL.
LAUNCHPAD_RAG_URL=
# Supabase Storage for documents issuers share with the assistant. Service role key,
# server only. The private bucket is created on first upload if it doesn't exist.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LAUNCHPAD_ASSISTANT_BUCKET=launchpad-assistant-docs
# Documents attached to applications (kept for reviewers, shared as signed links).
LAUNCHPAD_APPLICATION_BUCKET=launchpad-application-docs

# Shared Neko contracts, written by contracts/scripts/deploy-shared.sh.
# Regenerate this block with: cd contracts && ./scripts/print-env.sh
NEXT_PUBLIC_STELLAR_USDC_CONTRACT_ID=
NEXT_PUBLIC_CLAIM_TOPICS_CONTRACT_ID=
NEXT_PUBLIC_CLAIM_ISSUER_CONTRACT_ID=
NEXT_PUBLIC_IDENTITY_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_IDENTITY_VERIFIER_CONTRACT_ID=
NEXT_PUBLIC_FACTORY_CONTRACT_ID=
NEXT_PUBLIC_MILESTONE_TRACKER_CONTRACT_ID=
